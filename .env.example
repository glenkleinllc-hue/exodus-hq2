# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# Never commit the real file. .env is gitignored.

# --- Supabase -------------------------------------------------------------
# Project -> Settings -> API. Use the SERVICE ROLE key, not the anon key.
# It stays on the server and is never sent to the browser.
SUPABASE_URL=https://eeeleawnlcmpgcwqianl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ------------------------------------------------------------
# console.anthropic.com -> API keys. Load at least $5 of credit.
ANTHROPIC_API_KEY=

# --- Gate ----------------------------------------------------------------
# One shared password so the page is not open to the whole internet.
# Pick anything you will remember.
HQ_PASSWORD=

# --- formsubmit webhook --------------------------------------------------
# Any random string. You put the same value in the form's webhook URL.
FORM_WEBHOOK_SECRET=

# --- Lead email notification --------------------------------------------
# Your email. Every lead that hits the webhook still gets emailed to you
# through formsubmit, so nothing changes about how you find out.
NOTIFY_EMAIL=glenkleinllc@gmail.com

# --- Google Calendar (add in phase 3, leave blank for now) ---------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
